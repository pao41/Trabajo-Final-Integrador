DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/gimnasio
FRONTEND_ORIGIN=http://localhost:5173

# Clave para firmar las sesiones (mínimo 32 caracteres):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-de-al-menos-32-caracteres
# Duración de la sesión en minutos (480 = un turno de 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# En producción (HTTPS): true
COOKIE_SECURE=false